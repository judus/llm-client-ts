{
  "name": "@maduser/ai-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral fluent AI client with MCP, history, documents, and voice.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "build": "tsc --project tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.20.0"
  }
}
