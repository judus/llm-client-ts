{
  "name": "@maduser/ai-ts-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Model Context Protocol integration for @maduser/ai-ts.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "build": "tsc --project tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@maduser/ai-ts": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "devDependencies": {
    "@maduser/ai-ts-testing": "workspace:*"
  }
}
